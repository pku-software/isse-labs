{
  "id": null,
  "uid": "lab4-chat-monitoring",
  "title": "Lab 4 - Chat Application Monitoring",
  "tags": ["lab4", "chat-app"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "2s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "成功 / 失败请求速率",
      "description": "最近 30 秒窗口内每秒完成的聊天请求数，按 outcome 区分。",
      "datasource": {"type": "prometheus", "uid": "lab4-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (outcome) (rate(chat_requests_total{job=\"chat-app\"}[30s]))", "legendFormat": "{{outcome}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "正在处理的聊天请求",
      "description": "当前正在执行聊天处理的请求数，不代表在线用户数。",
      "datasource": {"type": "prometheus", "uid": "lab4-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "sum(chat_inprogress_requests{job=\"chat-app\"})", "legendFormat": "in progress", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "平均聊天处理耗时",
      "description": "最近 30 秒窗口的服务端平均处理耗时；Histogram 也包含各桶、总和与样本数。",
      "datasource": {"type": "prometheus", "uid": "lab4-prometheus"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9},
      "targets": [{"expr": "sum(rate(chat_request_duration_seconds_sum{job=\"chat-app\"}[30s])) / sum(rate(chat_request_duration_seconds_count{job=\"chat-app\"}[30s]))", "legendFormat": "mean duration", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "placement": "bottom"}, "tooltip": {"mode": "single"}}
    }
  ]
}
