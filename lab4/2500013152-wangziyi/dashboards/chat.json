{
  "uid": "lab4-wangziyi",
  "title": "Lab 4 · 王子懿 · 聊天应用监控",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "2s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "成功 / 失败请求速率",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab4-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(chat_requests_total{job=\"chat-app\"}[30s]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "正在处理的聊天请求",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab4-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(chat_inprogress_requests{job=\"chat-app\"})",
          "legendFormat": "在途请求"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "平均处理耗时",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lab4-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(chat_request_duration_seconds_sum{job=\"chat-app\"}[30s])) / sum(rate(chat_request_duration_seconds_count{job=\"chat-app\"}[30s]))",
          "legendFormat": "平均耗时"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "tags": [
    "lab4"
  ]
}